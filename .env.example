# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env.

# Base de données
POSTGRES_USER=leypilot
POSTGRES_PASSWORD=changer-moi
POSTGRES_DB=leypilot
DATABASE_URL=postgresql+psycopg://leypilot:changer-moi@db:5432/leypilot

# Légifrance via PISTE (P1)
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=

# LLM (P2)
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Authentification (P5)
JWT_SECRET=changer-moi
JWT_DUREE_MINUTES=60

# Notifications Web Push (P5)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
